---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Navbar from "../components/Navbar.astro";
import AboutSection from "../components/AboutSection.astro";
import ResumeSection from "../components/ResumeSection.astro";
import PortfolioSection from "../components/PortfolioSection.astro";
import CertificatesSection from "../components/CertificatesSection.astro";
import ContactSection from "../components/ContactSection.astro";
import TestimonialModal from "../components/TestimonialModal.astro";
import CertModal from "../components/CertModal.astro";
---

<BaseLayout>
  <div class="theater-stage" data-preloader>
    <!-- Overhead Stage Spotlight Beam -->
    <div class="theater-spotlight" aria-hidden="true"></div>

    <!-- Top Grand Valance / Swag Header with Gold Fringe -->
    <div class="theater-valance" aria-hidden="true">
      <div class="valance-swags">
        <div class="swag"></div>
        <div class="swag"></div>
        <div class="swag"></div>
        <div class="swag"></div>
        <div class="swag"></div>
      </div>
      <div class="gold-fringe"></div>
    </div>

    <!-- Left Velvet Theater Curtain -->
    <div class="theater-curtain curtain-left" aria-hidden="true">
      <div class="curtain-fabric"></div>
      <div class="curtain-inner-cord"></div>
      <div class="curtain-bottom-fringe"></div>
    </div>

    <!-- Right Velvet Theater Curtain -->
    <div class="theater-curtain curtain-right" aria-hidden="true">
      <div class="curtain-fabric"></div>
      <div class="curtain-inner-cord"></div>
      <div class="curtain-bottom-fringe"></div>
    </div>

    <!-- Center Theatrical Marquee Plaque -->
    <div class="theater-marquee">
      <div class="marquee-frame">
        <div class="marquee-monogram">
          <span class="bracket">&lt;</span><span class="accent">YM</span><span class="slash">/</span><span class="bracket">&gt;</span>
        </div>
        <span class="marquee-eyebrow">THE PORTFOLIO OF</span>
        <h1 class="marquee-title">YOHANNES MESFIN</h1>
        <div class="marquee-divider">
          <span class="star">&#9733;</span>
          <span class="divider-line"></span>
          <span class="star">&#9733;</span>
        </div>
        <span class="marquee-subtitle">THE STAGE IS SET</span>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const stage = document.querySelector("[data-preloader]");
      if (!stage) return;

      function triggerOpening() {
        if (stage.classList.contains("loaded")) return;
        stage.classList.add("loaded");
        setTimeout(function () {
          stage.style.display = "none";
        }, 1600);
      }

      // Auto-open after a short dramatic pause (500ms)
      setTimeout(triggerOpening, 500);

      // Click or tap anywhere on the curtain/stage to open immediately
      stage.addEventListener("click", triggerOpening);

      // Multi-event fallbacks so it never gets stuck regardless of network conditions
      if (document.readyState === "complete" || document.readyState === "interactive") {
        setTimeout(triggerOpening, 400);
      } else {
        document.addEventListener("DOMContentLoaded", function () {
          setTimeout(triggerOpening, 450);
        });
        window.addEventListener("load", function () {
          setTimeout(triggerOpening, 300);
        });
      }

      // Expose globally so user can replay anytime by running replayCurtain()
      window.replayCurtain = function () {
        stage.style.display = "flex";
        stage.classList.remove("loaded");
        setTimeout(triggerOpening, 600);
      };
    })();
  </script>

  <canvas id="particles-canvas" aria-hidden="true"></canvas>

  <button class="theme-toggle-btn" data-theme-btn title="Toggle Theme" aria-label="Toggle dark and light theme">
    <ion-icon name="moon-outline" class="moon-icon"></ion-icon>
    <ion-icon name="sunny-outline" class="sun-icon"></ion-icon>
  </button>

  <button class="back-to-top" data-back-top title="Back to top" aria-label="Back to top">
    <ion-icon name="chevron-up-outline"></ion-icon>
  </button>

  <main>
    <Sidebar />
    <div class="main-content">
      <Navbar />
      <AboutSection />
      <ResumeSection />
      <PortfolioSection />
      <CertificatesSection />
      <ContactSection />
    </div>
  </main>

  <TestimonialModal />
  <CertModal />

  <script type="module" defer src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule defer src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

  <script is:inline defer src="/assets/js/script.js"></script>
</BaseLayout>
