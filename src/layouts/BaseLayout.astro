---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = "Yohannes Mesfin | Specialist — CVM Development & Operations", description = "Yohannes Mesfin - Specialist in CVM Development & Operations at Safaricom Ethiopia, specializing in Customer Value Management frameworks, FinTech, Python, and Automation.", image = "https://yohannesweb.netlify.app/assets/images/my-avatar.png" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="shortcut icon" href="/assets/images/logo.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-icons-font@latest/font/simple-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>

    <meta name="description" content={description} />
    <meta name="keywords" content="CVM, Customer Value Management, Safaricom Ethiopia, Telecom, FinTech, M-PESA, Automation, Python, Robot Framework, CI/CD, DevOps, Yohannes Mesfin" />
    <meta name="author" content="Yohannes Mesfin" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content="https://yohannesweb.netlify.app" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />

    <link rel="canonical" href="https://yohannesweb.netlify.app" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Yohannes Mesfin",
      "url": "https://yohannesweb.netlify.app",
      "image": "https://yohannesweb.netlify.app/assets/images/my-avatar.png",
      "jobTitle": "Specialist — CVM Development and Operations",
      "worksFor": {
        "@type": "Organization",
        "name": "Safaricom Ethiopia Telecommunications PLC"
      },
      "email": "mesfiny711@gmail.com",
      "telephone": "+251954906800",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Addis Ababa",
        "addressCountry": "ET"
      },
      "sameAs": [
        "https://www.linkedin.com/in/yohannesmesfin",
        "https://github.com/yohannesmesfin"
      ],
      "knowsAbout": [
        "QA Automation", "Python", "Robot Framework",
        "Jenkins", "CI/CD", "DevOps", "ISO 27001"
      ]
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
