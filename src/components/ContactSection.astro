<article class="contact" data-page="contact">
  <header>
    <h2 class="h2 article-title">Contact</h2>
  </header>

  <section class="mapbox" data-reveal="left">
    <figure>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126113.3651875699!2d38.69696095!3d8.9855775!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x164b85cef5ab402d%3A0x8467b3b9f0e0e0e0!2sAddis%20Ababa%2C%20Ethiopia!5e0!3m2!1sen!2s!4v1"
        width="100%" height="300" loading="lazy"
        title="Map of Addis Ababa, Ethiopia"
        style="border:0;border-radius:12px;filter:grayscale(0.3) invert(0.85) hue-rotate(100deg);">
      </iframe>
    </figure>
  </section>

  <section class="contact-form" data-reveal="right">
    <h3 class="h3 form-title">Send a Message</h3>
    <form action="#" class="form" data-form>
      <!-- Honeypot: hidden from real users -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />

      <div class="input-wrapper">
        <input type="text" name="fullname" class="form-input" placeholder="Full name" required data-form-input />
        <input type="email" name="email" class="form-input" placeholder="Email address" required data-form-input />
      </div>
      <textarea name="message" class="form-input" placeholder="Your Message" required data-form-input
        style="min-height:120px"></textarea>
      <button class="form-btn" type="submit" disabled data-form-btn>
        <ion-icon name="paper-plane-outline"></ion-icon>
        <span>Send Message</span>
      </button>
      <div class="form-message" data-form-message></div>
    </form>
  </section>
</article>
