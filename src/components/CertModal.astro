<div class="cert-modal-container" data-cert-modal role="dialog" aria-modal="true" aria-labelledby="cert-modal-title" aria-hidden="true">
  <div class="cert-overlay" data-cert-overlay></div>
  <section class="cert-modal" role="document">
    <button class="cert-modal-close" data-cert-close aria-label="Close credential">
      <ion-icon name="close-outline"></ion-icon>
    </button>

    <div class="cert-modal-header">
      <div class="cert-modal-badge-ring">
        <div class="cert-modal-badge" data-cert-modal-icon>
          <ion-icon name="ribbon-outline"></ion-icon>
        </div>
      </div>
      <div class="cert-modal-status" data-cert-modal-status>
        <ion-icon name="checkmark-circle"></ion-icon>
        <span>Verified Credential</span>
      </div>
    </div>

    <div class="cert-modal-body">
      <h4 class="cert-modal-title" id="cert-modal-title" data-cert-modal-title>Title</h4>
      <p class="cert-modal-issuer" data-cert-modal-issuer>Issuer</p>

      <div class="cert-modal-details">
        <div class="cert-detail-item">
          <span class="cert-detail-label">Credential ID</span>
          <span class="cert-detail-value" data-cert-modal-id>—</span>
        </div>
        <div class="cert-detail-item">
          <span class="cert-detail-label">Issue Date</span>
          <span class="cert-detail-value" data-cert-modal-date>—</span>
        </div>
        <div class="cert-detail-item">
          <span class="cert-detail-label">Expiration</span>
          <span class="cert-detail-value" data-cert-modal-expiry>No Expiration</span>
        </div>
        <div class="cert-detail-item">
          <span class="cert-detail-label">Status</span>
          <span class="cert-detail-value cert-status-active" data-cert-modal-status-text>Active</span>
        </div>
      </div>

      <a href="#" data-cert-modal-url target="_blank" rel="noopener noreferrer" class="cert-verify-btn">
        <ion-icon name="open-outline"></ion-icon>
        <span>Verify Credential</span>
      </a>
    </div>
  </section>
</div>
