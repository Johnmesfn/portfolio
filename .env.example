# Database (Turso Edge LibSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Media Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Alerts (Resend) — Optional: alerts fire automatically when set
RESEND_API_KEY=re_your_resend_api_key
CONTACT_NOTIFY_EMAIL=mesfiny711@gmail.com
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Runtime & CORS
ALLOWED_ORIGINS=https://yohannesweb.netlify.app,http://localhost:8888,http://localhost:4321
NODE_ENV=development

